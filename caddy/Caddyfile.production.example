{$DOMAIN} {
  encode zstd gzip

  header {
    Referrer-Policy "no-referrer"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Content-Security-Policy "default-src 'self'; connect-src 'self' ws: wss:; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
  }

  handle /api/* {
    reverse_proxy backend:8000
  }

  handle /ws/* {
    reverse_proxy backend:8000
  }

  handle {
    reverse_proxy frontend:80
  }
}