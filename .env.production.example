# Production configuration for ich-bin-hier.de.
# Copy this file to .env on the production server and replace every CHANGE_ME value.
APP_ENV=production
DOMAIN=ich-bin-hier.de

POSTGRES_DB=preorder
POSTGRES_USER=preorder
POSTGRES_PASSWORD=change-me-to-a-strong-database-password
DATABASE_URL=postgresql+psycopg://preorder:change-me-to-a-strong-database-password@postgres:5432/preorder

SESSION_SECRET=dev-change-me-to-at-least-32-random-characters
SESSION_MAX_AGE=28800
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=https://ich-bin-hier.de
