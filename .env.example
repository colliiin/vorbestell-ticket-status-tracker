# development or production
APP_ENV=development
DOMAIN=localhost
POSTGRES_DB=preorder
POSTGRES_USER=preorder
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://preorder:change-me@postgres:5432/preorder
SESSION_SECRET=dev-change-this-to-a-long-random-secret
SESSION_MAX_AGE=28800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Create staff users explicitly:
# docker compose exec backend python -m app.cli.create_admin --username admin --role admin